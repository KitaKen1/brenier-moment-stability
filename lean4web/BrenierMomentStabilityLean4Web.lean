    D.clippedCDF x ∈ Icc (0 : ℝ) 1 := by
  rw [← D.cdf_image]
  exact ⟨Set.projIcc D.lower D.upper D.lower_lt_upper.le x,
    (Set.projIcc D.lower D.upper D.lower_lt_upper.le x).property, rfl⟩

