      exact setIntegral_le_integral hu (ae_of_all _ fun x => by positivity)
    _ = 4 * ∫ x, (g x) ^ 2 ∂μ := by
      rw [integral_add (hshift.const_mul 2) (hg.const_mul 2),
        integral_const_mul, integral_const_mul,
        integral_add_right_eq_self (fun x => (g x) ^ 2) v]
