      ((FiniteAffine.potential y a x - FiniteAffine.potential z b x) ^ 2) ∂ρ) ≤
      ENNReal.ofReal (P ^ 2 * wasserstein2 μ ν ^ 2) := by
    rw [hρ.lintegral_potential_sq y a z b]
    exact ENNReal.ofReal_le_ofReal hL2
