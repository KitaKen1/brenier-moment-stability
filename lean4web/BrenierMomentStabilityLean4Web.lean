            (4 * d * P ^ 2 * wasserstein2 μ ν ^ 2 / h ^ 2 + 24 * d * H ^ 2 * h * B) := by
  obtain ⟨N, hN, w, y, z, hw, hsum, _, _, hμeq, hνeq, _, henergy, hinj⟩ :=
