  have hsupport : ∀ z ∈ K, u x + inner ℝ q (z - x) ≤ u z :=
    supporting_inequality_of_tendsto (interior_subset hx)
      (fun z hz => (hu z hz).mono_left hUl) hUq (hUl hs)
