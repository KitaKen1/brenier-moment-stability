    (K : Set (E d))
    {l : Filter β} [l.IsCountablyGenerated]
    {ys : β → ι → E d} {cs : β → ι → ℝ} {y : ι → E d} {c : ι → ℝ}
    (i : ι) (hinj : Function.Injective y)
    (hy : ∀ j, Tendsto (fun n => ys n j) l (𝓝 (y j)))
    (hc : ∀ j, Tendsto (fun n => cs n j) l (𝓝 (c j))) :
