variable {d : ℕ}

/-- The closed coordinate box with sides `[lo k, hi k]`. -/
def coordBox (lo hi : Fin d → ℝ) : Set (E d) :=
  {x | ∀ k, x k ∈ Set.Icc (lo k) (hi k)}

