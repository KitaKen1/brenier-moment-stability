    inferInstance,
    (simpleFunc_map_finite_support μ q).2, ?_,
    wasserstein2_map_le_quantization_error hμ hε.le q.measurable
      (fun x hx => (hqerr x hx).le)⟩
  · rintro y ⟨x, rfl⟩
    exact hqY x
  · unfold IsSupported
    rw [Measure.map_apply q.measurable hY.measurableSet.compl]
    have hempty : q ⁻¹' Yᶜ = ∅ := by
      ext x
      simp [hqY x]
