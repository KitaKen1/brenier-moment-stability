  | succ n ih =>
    intro hn s hs
    exact hstep n (Nat.lt_of_succ_le hn) (sample Q n (Fin.init s))
      (ih (Nat.le_of_succ_le hn) (Fin.init s) (fun i => hs i.castSucc))
