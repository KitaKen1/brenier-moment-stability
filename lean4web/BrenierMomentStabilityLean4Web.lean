      integral_mono hdiff.norm (hd.const_mul _) (fun p => by
        simpa only [dist_eq_norm] using hf.dist_le_mul p.1 p.2)
    _ = (L : ℝ) * ∫ p : E d × E d, ‖p.1 - p.2‖ ∂π := integral_const_mul _ _
    _ ≤ _ := mul_le_mul_of_nonneg_left hmean L.coe_nonneg

