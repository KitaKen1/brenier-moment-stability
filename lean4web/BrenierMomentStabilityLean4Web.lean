/-- The second-moment inequality for a real random variable on a probability space. -/
theorem testing_integral_sq_le {X : Type*} [MeasurableSpace X]
    {ρ : Measure X} [IsProbabilityMeasure ρ] {f : X → ℝ} (hf : MemLp f 2 ρ) :
