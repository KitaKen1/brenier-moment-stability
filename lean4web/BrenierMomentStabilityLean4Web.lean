theorem exists_atomic_coupling_matrix_with_wasserstein_cost
    {d : ℕ} {ι κ : Type*} [Fintype ι] [Fintype κ]
    (w : ι → ℝ≥0∞) (v : κ → ℝ≥0∞) (y : ι → E d) (z : κ → E d)
    (hw : ∑ i, w i = 1) (hv : ∑ j, v j = 1)
