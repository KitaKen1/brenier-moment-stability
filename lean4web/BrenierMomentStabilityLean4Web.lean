/-- A globally supporting selection; finite affine maximizers satisfy this directly. -/
def Supports (u : F → ℝ) (T : F → F) : Prop :=
  ∀ x z, u x + ⟪z - x, T x⟫ ≤ u z

def quotient (u : F → ℝ) (h : ℝ) (e x : F) : ℝ :=
  (u (x + h • e) - u x) / h

def slope (T : F → F) (e x : F) : ℝ := ⟪e, T x⟫

