def rectangleSwap (w : ι → κ → ℝ) (ε : ℝ) (i k : ι) (j l : κ)
    (u : ι) (v : κ) : ℝ :=
  w u v + ε * ((if u = i then 1 else 0) - (if u = k then 1 else 0)) *
    ((if v = l then 1 else 0) - (if v = j then 1 else 0))

