    (T : E d → E d) : Prop :=
  Measurable T ∧
    Measure.map T ρ = μ ∧
    ∀ π : Measure (E d × E d),
      IsCoupling ρ μ π →
        quadraticPlanCost (graphPlan ρ T) ≤ quadraticPlanCost π

def IsUniqueQuadraticOptimalMap {d : ℕ} (ρ μ : Measure (E d))
    (T : E d → E d) : Prop :=
  IsQuadraticOptimalMap ρ μ T ∧
    ∀ π : Measure (E d × E d),
      IsCoupling ρ μ π →
        quadraticPlanCost π ≤ quadraticPlanCost (graphPlan ρ T) →
          π = graphPlan ρ T

