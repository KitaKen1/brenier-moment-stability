  Real.sqrt
    (ENNReal.toReal
      (sInf {r : ℝ≥0∞ |
        ∃ π : Measure (E d × E d),
          IsCoupling μ ν π ∧ quadraticPlanCost π = r}))

def graphPlan {d : ℕ} (ρ : Measure (E d)) (T : E d → E d) :
    Measure (E d × E d) :=
  Measure.map (fun x => (x, T x)) ρ

