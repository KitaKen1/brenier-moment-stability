/-- Joint measurability is preserved by integrating between measurable endpoints. -/
theorem stronglyMeasurable_intervalIntegral_endpoints
    {X : Type*} [MeasurableSpace X] {f : X → ℝ → ℝ} {a b : X → ℝ}
