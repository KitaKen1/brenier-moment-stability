    (T S : E d → E d) : ℝ :=
  Real.sqrt (∫ x, ‖T x - S x‖ ^ 2 ∂ρ)

def cube (d : ℕ) : Set (E d) :=
  {x | ∀ i, |x i| ≤ 1}

