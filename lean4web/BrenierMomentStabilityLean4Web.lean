    (P : V → X) (hP : Continuous P)
    (hprojection : ∀ (z : X) (t : ℝ), P (base z + t • u) = z)
    (hface : ∀ x, ⟪n, base x⟫_ℝ + c = 0)
    (htrans : 0 < ⟪n, u⟫_ℝ)
