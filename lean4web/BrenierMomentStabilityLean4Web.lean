    by_cases hkj : k = j
    · subst k
      exact Filter.Eventually.of_forall (fun _ _ h => (h rfl).elim)
    have ht (k : ι) : Tendsto (fun a => inner ℝ (F a w) (y' a k) + c' a k) l
