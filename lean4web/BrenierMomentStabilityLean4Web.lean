variable {d : ℕ} {ι : Type*}

/-- The geometric closed cell is the score cell restricted to the source body. -/
theorem closedCell_eq_inter_scoreCell
    (K : Set (E d)) (y : ι → E d) (c : ι → ℝ) (i : ι) :
    closedCell K y c i = K ∩ scoreCell y c i := by
