lemma IsFinitePotentialMap.bounded {T : E d → E d} (hT : IsFinitePotentialMap T) :
    ∃ C : ℝ, ∀ x, ‖T x‖ ≤ C := by
  obtain ⟨n, y, a, hact⟩ := hT
  refine ⟨∑ i, ‖y i‖, fun x => ?_⟩
  obtain ⟨i, hi, _⟩ := hact x
