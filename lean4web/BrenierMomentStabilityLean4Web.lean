theorem isCompact_probabilityCouplings_of_supported {d : ℕ}
    {μ ν : ProbabilityMeasure (E d)} {K Y : Set (E d)}
    (hK : IsCompact K) (hY : IsCompact Y)
    (hμ : (μ : Measure (E d)) Kᶜ = 0) (hν : (ν : Measure (E d)) Yᶜ = 0) :
