def targetDual (y : ι → F) (c : ι → ℝ) (z : F) : ℝ :=
  ∑ i, ({y i} : Set F).indicator (fun _ => targetDualAt y c i) z

omit [Nonempty ι] [InnerProductSpace ℝ F] in
lemma targetDual_site (y : ι → F) (c : ι → ℝ) (hy : Function.Injective y)
