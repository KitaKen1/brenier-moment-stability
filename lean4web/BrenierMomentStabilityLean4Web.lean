-- BEGIN SOURCE: BrenierMoment/PowerSource.lean
section
/-!
# The atomic potential estimate for power densities

A density proportional to `h ^ r`, with `h` positive and concave on a bounded
open convex set, is reached from the uniform case by `r` one-coordinate lifts:
the density `h ^ (r + 1)` is the marginal of the density `h ^ r` on the region
under the graph of `h`, which is again bounded, open and convex, with radius
increased from `R` to `√(R² + η²)` when `h ≤ η`. Since the constant of the
uniform estimate depends on the source only through its radius, induction on
`r` gives the constant `c₀ * √(R² + r η²)`.

The uniform estimate enters as the hypothesis `UniformPotentialBound c₀`.
-/

namespace BrenierMoment

open MeasureTheory OAI.Problem358
open scoped ENNReal

noncomputable section

/-- The atomic potential estimate for uniform sources on convex bodies of every
dimension, with a constant proportional to the radius of the body. -/
def UniformPotentialBound (c₀ : ℝ) : Prop :=
  ∀ (k : ℕ) (K : Set (E k)) (R : ℝ), IsCompact K → Convex ℝ K → (interior K).Nonempty →
    (∀ x ∈ K, ‖x‖ ≤ R) → AtomicPotentialBound (uniformMeasure K) (c₀ * R)

variable {k : ℕ}

/-- A positive concave function, bounded by `η`, on a nonempty open convex set. -/
structure ConcaveProfile (U : Set (E k)) (h : E k → ℝ) (η : ℝ) : Prop where
  isOpen : IsOpen U
  nonempty : U.Nonempty
  measurable : Measurable h
  continuousOn : ContinuousOn h U
  concaveOn : ConcaveOn ℝ U h
  pos : ∀ x ∈ U, 0 < h x
  le : ∀ x ∈ U, h x ≤ η

/-- The profile is inherited by the region under the graph. -/
lemma ConcaveProfile.subgraph {U : Set (E k)} {h : E k → ℝ} {η : ℝ}
    (hp : ConcaveProfile U h η) :
    ConcaveProfile (subgraph U h) (fun w => h (dropLast w)) η where
  isOpen := isOpen_subgraph hp.isOpen hp.continuousOn
  nonempty := subgraph_nonempty hp.nonempty hp.pos
  measurable := hp.measurable.comp measurable_dropLast
  continuousOn := hp.continuousOn.comp continuous_dropLast.continuousOn fun _ hw => hw.1
  concaveOn := (hp.concaveOn.comp_linearMap dropLast).subset (fun _ hw => hw.1)
    (convex_subgraph hp.concaveOn)
  pos := fun _ hw => hp.pos _ hw.1
  le := fun _ hw => hp.le _ hw.1

/-- With exponent zero the power source is the uniform measure of the closure. -/
lemma powerSource_zero {U : Set (E k)} (hconv : Convex ℝ U) (h : E k → ℝ) :
    powerSource U h 0 = uniformMeasure (closure U) := by
  have hae : closure U =ᵐ[volume] U :=
    closure_ae_eq_of_null_frontier (hconv.addHaar_frontier volume)
  have hpm : powerMeasure U h 0 = volume.restrict U := by
    unfold powerMeasure
    simp only [pow_zero, ENNReal.ofReal_one]
    exact withDensity_one
  unfold powerSource uniformMeasure
  rw [hpm, Measure.restrict_apply_univ, Measure.restrict_congr_set hae, measure_congr hae]

/-- **Power densities.** If uniform sources satisfy the atomic potential
estimate with constant `c₀ * R`, then a source with density proportional to
`h ^ r` on a set of radius `R`, with `h` a concave profile bounded by `η`,
satisfies it with constant `c₀ * √(R² + r η²)`. -/
theorem atomicPotentialBound_powerSource {c₀ : ℝ} (hc₀ : UniformPotentialBound c₀) (r : ℕ) :
    ∀ (k : ℕ) (U : Set (E k)) (h : E k → ℝ) (R η : ℝ), ConcaveProfile U h η →
      (∀ x ∈ U, ‖x‖ ≤ R) →
      AtomicPotentialBound (powerSource U h r) (c₀ * Real.sqrt (R ^ 2 + r * η ^ 2)) := by
  induction r with
  | zero =>
    intro k U h R η hp hR
    obtain ⟨x₀, hx₀⟩ := hp.nonempty
    have hR0 : 0 ≤ R := (norm_nonneg x₀).trans (hR x₀ hx₀)
    have hsub : closure U ⊆ Metric.closedBall (0 : E k) R :=
      closure_minimal (fun x hx => mem_closedBall_zero_iff.mpr (hR x hx))
        Metric.isClosed_closedBall
    have hcompact : IsCompact (closure U) :=
      (isCompact_closedBall (0 : E k) R).of_isClosed_subset isClosed_closure hsub
    have hint : (interior (closure U)).Nonempty :=
      ⟨x₀, hp.isOpen.subset_interior_closure hx₀⟩
    have hbase := hc₀ k (closure U) R hcompact hp.concaveOn.1.closure hint
      (fun x hx => mem_closedBall_zero_iff.mp (hsub hx))
    rw [powerSource_zero hp.concaveOn.1]
    have hconst : c₀ * Real.sqrt (R ^ 2 + ((0 : ℕ) : ℝ) * η ^ 2) = c₀ * R := by
      rw [Nat.cast_zero, zero_mul, add_zero, Real.sqrt_sq hR0]
    rw [hconst]
    exact hbase
  | succ r ih =>
    intro k U h R η hp hR
    have hlift := ih (k + 1) (subgraph U h) (fun w => h (dropLast w))
      (Real.sqrt (R ^ 2 + η ^ 2)) η hp.subgraph
      (fun w hw => norm_le_of_mem_subgraph hR hp.le hw)
    have hmarg := map_dropLast_powerSource hp.isOpen.measurableSet hp.measurable
      (fun x hx => (hp.pos x hx).le) r
    have hdesc := AtomicPotentialBound.of_marginal hmarg
      (powerSource_absolutelyContinuous U h (r + 1)) hlift
    have hconst : c₀ * Real.sqrt (Real.sqrt (R ^ 2 + η ^ 2) ^ 2 + (r : ℝ) * η ^ 2) =
        c₀ * Real.sqrt (R ^ 2 + ((r + 1 : ℕ) : ℝ) * η ^ 2) := by
      rw [Real.sq_sqrt (by positivity)]
      push_cast
      congr 2
      ring
    rw [← hconst]
    exact hdesc

/-- Scaling the profile by a positive constant does not change the normalized source. -/
lemma powerSource_const_mul (U : Set (E k)) (h : E k → ℝ) {t : ℝ} (ht : 0 < t) (r : ℕ) :
    powerSource U (fun x => t * h x) r = powerSource U h r := by
  have hpm : powerMeasure U (fun x => t * h x) r =
      ENNReal.ofReal (t ^ r) • powerMeasure U h r := by
    unfold powerMeasure
    have hfun : (fun x => ENNReal.ofReal ((t * h x) ^ r)) =
        ENNReal.ofReal (t ^ r) • fun x => ENNReal.ofReal (h x ^ r) := by
      funext x
      rw [Pi.smul_apply, smul_eq_mul, mul_pow, ENNReal.ofReal_mul (pow_nonneg ht.le r)]
    change (volume.restrict U).withDensity (fun x => ENNReal.ofReal ((t * h x) ^ r)) = _
    rw [hfun, withDensity_smul' _ _ ENNReal.ofReal_ne_top]
  have h0 : ENNReal.ofReal (t ^ r) ≠ 0 := (ENNReal.ofReal_pos.mpr (pow_pos ht r)).ne'
  unfold powerSource
  rw [hpm, Measure.smul_apply, smul_eq_mul,
    ENNReal.mul_inv (Or.inl h0) (Or.inl ENNReal.ofReal_ne_top), smul_smul, mul_right_comm,
    ENNReal.inv_mul_cancel h0 ENNReal.ofReal_ne_top, one_mul]

/-- **Power densities, normalized.** For a positive exponent the bound of the
profile is scaled away, and the constant is `c₀ * √(R² + 1)` whatever the
exponent. -/
theorem atomicPotentialBound_powerSource_unit {c₀ : ℝ} (hc₀ : UniformPotentialBound c₀)
    {U : Set (E k)} {h : E k → ℝ} {R η : ℝ} (hp : ConcaveProfile U h η)
    (hR : ∀ x ∈ U, ‖x‖ ≤ R) {r : ℕ} (hr : 0 < r) :
    AtomicPotentialBound (powerSource U h r) (c₀ * Real.sqrt (R ^ 2 + 1)) := by
  obtain ⟨x₀, hx₀⟩ := hp.nonempty
  have hη : 0 < η := (hp.pos x₀ hx₀).trans_le (hp.le x₀ hx₀)
  have hr' : (0 : ℝ) < r := Nat.cast_pos.mpr hr
  have hs : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr'
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = 1 / (η * Real.sqrt r) := ⟨_, rfl⟩
  have ht : 0 < t := by
    rw [ht_def]
    exact one_div_pos.mpr (mul_pos hη hs)
  have htη : t * η = 1 / Real.sqrt r := by
    rw [ht_def, div_mul_eq_mul_div, one_mul, div_eq_div_iff (mul_pos hη hs).ne' hs.ne']
    ring
  have hp' : ConcaveProfile U (fun x => t * h x) (1 / Real.sqrt r) :=
    { isOpen := hp.isOpen
      nonempty := hp.nonempty
      measurable := measurable_const.mul hp.measurable
      continuousOn := continuousOn_const.mul hp.continuousOn
      concaveOn := by
        refine ⟨hp.concaveOn.1, fun x hx y hy a b ha hb hab => ?_⟩
        have hc := hp.concaveOn.2 hx hy ha hb hab
        simp only [smul_eq_mul] at hc
        change a * (t * h x) + b * (t * h y) ≤ t * h (a • x + b • y)
        calc a * (t * h x) + b * (t * h y) = t * (a * h x + b * h y) := by ring
          _ ≤ t * h (a • x + b • y) := mul_le_mul_of_nonneg_left hc ht.le
      pos := fun x hx => mul_pos ht (hp.pos x hx)
      le := fun x hx => by
        rw [← htη]
        exact mul_le_mul_of_nonneg_left (hp.le x hx) ht.le }
  have hmain := atomicPotentialBound_powerSource hc₀ r k U (fun x => t * h x) R
    (1 / Real.sqrt r) hp' hR
  have hconst : R ^ 2 + (r : ℝ) * (1 / Real.sqrt r) ^ 2 = R ^ 2 + 1 := by
    rw [one_div, inv_pow, Real.sq_sqrt hr'.le, mul_inv_cancel₀ hr'.ne']
  rw [hconst, powerSource_const_mul U h ht r] at hmain
  exact hmain

end

end BrenierMoment
end
-- END SOURCE: BrenierMoment/PowerSource.lean

-- BEGIN SOURCE: BrenierMoment/LogConcave.lean
section
/-!
# The atomic potential estimate for log-concave sources

Let `V` be convex on a bounded open convex set `U`. On the part of `U` where
`V < n` the function `1 - V / n` is a positive concave profile, and its `n`-th
power increases to `exp (-V)`. The power sources therefore satisfy the atomic
potential estimate with a constant that does not depend on `n`, they are
dominated by a multiple `c n → 1` of the log-concave source, and the estimate
passes to the limit in total variation.
-/

namespace BrenierMoment

open MeasureTheory Filter OAI.Problem358
open scoped ENNReal Topology

noncomputable section

/-! ### Total variation from domination -/

/-- A probability measure dominated by `c` times another probability measure is
within `c - 1` of it on every measurable function with values in `[0, 1]`. -/
lemma abs_integral_sub_le_of_le_smul {α : Type*} [MeasurableSpace α] {μ ρ : Measure α}
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ρ] {c : ℝ≥0∞} (hc : c ≠ ∞)
    (hle : μ ≤ c • ρ) {g : α → ℝ} (hg : Measurable g) (hg01 : ∀ x, 0 ≤ g x ∧ g x ≤ 1) :
    |(∫ x, g x ∂μ) - ∫ x, g x ∂ρ| ≤ c.toReal - 1 := by
  have hint : ∀ (ν : Measure α) [IsProbabilityMeasure ν] (f : α → ℝ), Measurable f →
      (∀ x, 0 ≤ f x ∧ f x ≤ 1) → Integrable f ν := by
    intro ν _ f hf hf01
    refine Integrable.of_bound hf.aestronglyMeasurable 1 (Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨by linarith [(hf01 x).1], (hf01 x).2⟩
  have hone : ∀ (ν : Measure α) [IsProbabilityMeasure ν], (∫ _, (1 : ℝ) ∂ν) = 1 := by
    intro ν _
    simp
  have key : ∀ f : α → ℝ, Measurable f → (∀ x, 0 ≤ f x ∧ f x ≤ 1) →
      (∫ x, f x ∂μ) ≤ c.toReal * ∫ x, f x ∂ρ := by
    intro f hf hf01
    calc (∫ x, f x ∂μ) ≤ ∫ x, f x ∂(c • ρ) :=
          integral_mono_measure hle (Eventually.of_forall fun x => (hf01 x).1)
            ((hint ρ f hf hf01).smul_measure hc)
      _ = c.toReal * ∫ x, f x ∂ρ := by rw [integral_smul_measure, smul_eq_mul]
  have h1 := key g hg hg01
  have h2 := key (fun x => 1 - g x) (measurable_const.sub hg)
    (fun x => ⟨by linarith [(hg01 x).2], by linarith [(hg01 x).1]⟩)
  have hc1 : 1 ≤ c.toReal := by
    have h := key (fun _ => (1 : ℝ)) measurable_const (fun _ => ⟨zero_le_one, le_rfl⟩)
    rw [hone μ, hone ρ, mul_one] at h
    exact h
  rw [integral_sub (integrable_const (1 : ℝ)) (hint μ g hg hg01),
    integral_sub (integrable_const (1 : ℝ)) (hint ρ g hg hg01), hone μ, hone ρ] at h2
  have hρ0 : 0 ≤ ∫ x, g x ∂ρ := integral_nonneg fun x => (hg01 x).1
  have hρ1 : (∫ x, g x ∂ρ) ≤ 1 := by
    calc (∫ x, g x ∂ρ) ≤ ∫ _, (1 : ℝ) ∂ρ :=
          integral_mono (hint ρ g hg hg01) (integrable_const (1 : ℝ)) fun x => (hg01 x).2
      _ = 1 := hone ρ
  have hp1 := mul_nonneg (sub_nonneg.mpr hc1) hρ0
  have hp2 := mul_nonneg (sub_nonneg.mpr hc1) (sub_nonneg.mpr hρ1)
  rw [abs_le]
  constructor <;> nlinarith [h1, h2, hp1, hp2]

variable {d : ℕ}

/-- Domination by multiples of the limit gives a total-variation bound. -/
lemma tvBound_of_le_smul {ρN : ℕ → Measure (E d)} {ρ : Measure (E d)}
    [∀ N, IsProbabilityMeasure (ρN N)] [IsProbabilityMeasure ρ] {c : ℕ → ℝ≥0∞}
    (hc : ∀ N, c N ≠ ∞) (hle : ∀ N, ρN N ≤ c N • ρ) :
    TVBound ρN ρ fun N => (c N).toReal - 1 :=
  fun N _ hg hg01 => abs_integral_sub_le_of_le_smul (hc N) (hle N) hg hg01

/-! ### The sources -/

/-- The unnormalized source with density `exp (-V)` on `U`. -/
def expMeasure (U : Set (E d)) (V : E d → ℝ) : Measure (E d) :=
  (volume.restrict U).withDensity fun x => ENNReal.ofReal (Real.exp (-V x))

/-- The probability source with density proportional to `exp (-V)` on `U`. -/
def logConcaveSource (U : Set (E d)) (V : E d → ℝ) : Measure (E d) :=
  (expMeasure U V Set.univ)⁻¹ • expMeasure U V

lemma expMeasure_eq_powerMeasure (U : Set (E d)) (V : E d → ℝ) :
    expMeasure U V = powerMeasure U (fun x => Real.exp (-V x)) 1 := by
  unfold expMeasure powerMeasure
  simp only [pow_one]

lemma logConcaveSource_eq_powerSource (U : Set (E d)) (V : E d → ℝ) :
    logConcaveSource U V = powerSource U (fun x => Real.exp (-V x)) 1 := by
  unfold logConcaveSource powerSource
  rw [expMeasure_eq_powerMeasure]

/-- The part of `U` where `V < n`. -/
def sublevel (U : Set (E d)) (V : E d → ℝ) (n : ℕ) : Set (E d) := {x | x ∈ U ∧ V x < n}

/-- The profile `1 - V / n`, whose `n`-th power approximates `exp (-V)`. -/
def linProfile (V : E d → ℝ) (n : ℕ) (x : E d) : ℝ := 1 - V x / n

lemma sublevel_subset (U : Set (E d)) (V : E d → ℝ) (n : ℕ) : sublevel U V n ⊆ U :=
  fun _ hx => hx.1

lemma measurableSet_sublevel {U : Set (E d)} (hU : MeasurableSet U) {V : E d → ℝ}
    (hV : Measurable V) (n : ℕ) : MeasurableSet (sublevel U V n) :=
  hU.inter (measurableSet_lt hV measurable_const)

lemma measurable_linProfile {V : E d → ℝ} (hV : Measurable V) (n : ℕ) :
    Measurable (linProfile V n) :=
  measurable_const.sub (hV.div_const _)

lemma volume_ne_top_of_norm_le {U : Set (E d)} {R : ℝ} (hR : ∀ x ∈ U, ‖x‖ ≤ R) :
    volume U ≠ ∞ := by
  have hsub : U ⊆ Metric.closedBall (0 : E d) R :=
    fun x hx => mem_closedBall_zero_iff.mpr (hR x hx)
  exact ((measure_mono hsub).trans_lt measure_closedBall_lt_top).ne

/-- On the part of `U` where `V < n`, the function `1 - V / n` is a concave profile. -/
lemma concaveProfile_sublevel {U : Set (E d)} {V : E d → ℝ} {m : ℝ} (hU : IsOpen U)
    (hV : ConvexOn ℝ U V) (hVm : Measurable V) (hlow : ∀ x ∈ U, m ≤ V x) {n : ℕ}
    (hn : 0 < n) (hne : (sublevel U V n).Nonempty) :
    ConcaveProfile (sublevel U V n) (linProfile V n) (1 + |m|) := by
  have hn' : (0 : ℝ) < n := Nat.cast_pos.mpr hn
  have hcont : ContinuousOn V U := hV.continuousOn hU
  have hopen : IsOpen (sublevel U V n) :=
    hcont.isOpen_inter_preimage hU (isOpen_Iio (a := (n : ℝ)))
  have hconv : Convex ℝ (sublevel U V n) := hV.convex_lt (n : ℝ)
  refine
    { isOpen := hopen
      nonempty := hne
      measurable := measurable_linProfile hVm n
      continuousOn := ?_
      concaveOn := ⟨hconv, ?_⟩
      pos := ?_
      le := ?_ }
  · exact (continuousOn_const.sub (hcont.div_const _)).mono (sublevel_subset U V n)
  · intro x hx y hy a b ha hb hab
    have hc := hV.2 hx.1 hy.1 ha hb hab
    simp only [smul_eq_mul] at hc
    change a * (1 - V x / n) + b * (1 - V y / n) ≤ 1 - V (a • x + b • y) / n
    have hdiv : V (a • x + b • y) / n ≤ (a * V x + b * V y) / n :=
      div_le_div_of_nonneg_right hc hn'.le
    have hsplit : (a * V x + b * V y) / n = a * (V x / n) + b * (V y / n) := by ring
    linarith
  · intro x hx
    have hlt : V x / n < 1 := (div_lt_one hn').mpr hx.2
    change 0 < 1 - V x / n
    linarith
  · intro x hx
    have h1 : m / n ≤ V x / n := div_le_div_of_nonneg_right (hlow x hx.1) hn'.le
    have h1n : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have h2 : |m / n| ≤ |m| := by
      rw [abs_div, abs_of_pos hn']
      exact div_le_self (abs_nonneg m) h1n
    have h3 := neg_abs_le (m / n)
    change 1 - V x / n ≤ 1 + |m|
    linarith

/-- The truncated power density is below the exponential density. -/
lemma powerMeasure_sublevel_le {U : Set (E d)} (hU : MeasurableSet U) {V : E d → ℝ}
    (hV : Measurable V) (n : ℕ) :
    powerMeasure (sublevel U V n) (linProfile V n) n ≤ expMeasure U V := by
  have hS := measurableSet_sublevel hU hV n
  have h1 : powerMeasure (sublevel U V n) (linProfile V n) n ≤
      (volume.restrict (sublevel U V n)).withDensity
        fun x => ENNReal.ofReal (Real.exp (-V x)) := by
    unfold powerMeasure
    refine withDensity_mono ((ae_restrict_iff' hS).mpr (Eventually.of_forall fun x hx => ?_))
    exact ENNReal.ofReal_le_ofReal (Real.one_sub_div_pow_le_exp_neg hx.2.le)
  refine h1.trans ?_
  unfold expMeasure
  refine Measure.le_iff.mpr fun A hA => ?_
  rw [withDensity_apply _ hA, withDensity_apply _ hA]
  exact lintegral_mono' (Measure.restrict_mono Set.Subset.rfl
    (Measure.restrict_mono (sublevel_subset U V n) le_rfl)) le_rfl

/-- The normalized truncated power source is dominated by a multiple of the
log-concave source; the multiple is the ratio of the total masses. -/
lemma powerSource_sublevel_le {U : Set (E d)} (hU : MeasurableSet U) {V : E d → ℝ}
    (hV : Measurable V) (hZ0 : expMeasure U V Set.univ ≠ 0)
    (hZtop : expMeasure U V Set.univ ≠ ∞) (n : ℕ) :
    powerSource (sublevel U V n) (linProfile V n) n ≤
      (expMeasure U V Set.univ / powerMeasure (sublevel U V n) (linProfile V n) n Set.univ) •
        logConcaveSource U V := by
  have hle := powerMeasure_sublevel_le hU hV n
  unfold powerSource logConcaveSource
  rw [smul_smul, ENNReal.div_eq_inv_mul, mul_assoc, ENNReal.mul_inv_cancel hZ0 hZtop, mul_one]
  refine Measure.le_iff.mpr fun A _ => ?_
  rw [Measure.smul_apply, Measure.smul_apply, smul_eq_mul, smul_eq_mul]
  gcongr

/-- The total masses of the truncated power densities converge to the mass of
the exponential density. -/
lemma tendsto_powerMeasure_sublevel {U : Set (E d)} (hU : MeasurableSet U) {V : E d → ℝ}
    (hV : Measurable V) (hfin : expMeasure U V Set.univ ≠ ∞) (k₀ : ℕ) :
    Tendsto (fun N : ℕ =>
      powerMeasure (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) Set.univ)
      atTop (𝓝 (expMeasure U V Set.univ)) := by
  have hZ : expMeasure U V Set.univ = ∫⁻ x in U, ENNReal.ofReal (Real.exp (-V x)) := by
    rw [expMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hM : ∀ n : ℕ, powerMeasure (sublevel U V n) (linProfile V n) n Set.univ =
      ∫⁻ x in U, (sublevel U V n).indicator
        (fun x => ENNReal.ofReal (linProfile V n x ^ n)) x := by
    intro n
    rw [powerMeasure_univ, lintegral_indicator (measurableSet_sublevel hU hV n),
      Measure.restrict_restrict (measurableSet_sublevel hU hV n),
      Set.inter_eq_left.mpr (sublevel_subset U V n)]
  rw [hZ] at hfin ⊢
  simp only [hM]
  refine tendsto_lintegral_of_dominated_convergence
    (fun x => ENNReal.ofReal (Real.exp (-V x))) (fun N => ?_) (fun N => ?_) hfin ?_
  · exact (ENNReal.measurable_ofReal.comp
      ((measurable_linProfile hV (N + k₀)).pow_const (N + k₀))).indicator
        (measurableSet_sublevel hU hV (N + k₀))
  · refine Eventually.of_forall fun x => ?_
    change (sublevel U V (N + k₀)).indicator
      (fun x => ENNReal.ofReal (linProfile V (N + k₀) x ^ (N + k₀))) x ≤
        ENNReal.ofReal (Real.exp (-V x))
    by_cases hx : x ∈ sublevel U V (N + k₀)
    · rw [Set.indicator_of_mem hx]
      exact ENNReal.ofReal_le_ofReal (Real.one_sub_div_pow_le_exp_neg hx.2.le)
    · rw [Set.indicator_of_notMem hx]
      simp
  · filter_upwards [ae_restrict_mem hU] with x hxU
    obtain ⟨N₁, hN₁⟩ := exists_nat_gt (V x)
    have hlim : Tendsto
        (fun N : ℕ => ENNReal.ofReal ((1 + -V x / ((N + k₀ : ℕ) : ℝ)) ^ (N + k₀)))
        atTop (𝓝 (ENNReal.ofReal (Real.exp (-V x)))) :=
      (ENNReal.continuous_ofReal.tendsto _).comp
        ((Real.tendsto_one_add_div_pow_exp (-V x)).comp (tendsto_add_atTop_nat k₀))
    refine hlim.congr' ?_
    filter_upwards [eventually_ge_atTop N₁] with N hN
    have hcast : ((N₁ : ℕ) : ℝ) ≤ ((N + k₀ : ℕ) : ℝ) := by
      exact_mod_cast hN.trans (Nat.le_add_right N k₀)
    have hmem : x ∈ sublevel U V (N + k₀) := And.intro hxU (hN₁.trans_le hcast)
    change ENNReal.ofReal ((1 + -V x / ((N + k₀ : ℕ) : ℝ)) ^ (N + k₀)) =
      (sublevel U V (N + k₀)).indicator
        (fun x => ENNReal.ofReal (linProfile V (N + k₀) x ^ (N + k₀))) x
    rw [Set.indicator_of_mem hmem]
    change _ = ENNReal.ofReal ((1 - V x / ((N + k₀ : ℕ) : ℝ)) ^ (N + k₀))
    rw [neg_div, ← sub_eq_add_neg]

/-! ### Convex functions on bounded sets -/

/-- A convex function on a bounded open convex set is bounded below. -/
lemma exists_lower_bound_of_convexOn {U : Set (E d)} {V : E d → ℝ} {R : ℝ} (hU : IsOpen U)
    (hne : U.Nonempty) (hR : ∀ x ∈ U, ‖x‖ ≤ R) (hV : ConvexOn ℝ U V) :
    ∃ m : ℝ, ∀ x ∈ U, m ≤ V x := by
  obtain ⟨x₀, hx₀⟩ := hne
  have hR0 : 0 ≤ R := (norm_nonneg x₀).trans (hR x₀ hx₀)
  have hcont : ContinuousOn V U := hV.continuousOn hU
  have hnhds : ∀ᶠ z in 𝓝 x₀, z ∈ U ∧ V z < V x₀ + 1 :=
    (Filter.eventually_mem_set.mpr (hU.mem_nhds hx₀)).and
      ((hcont.continuousAt (hU.mem_nhds hx₀)).eventually_lt continuousAt_const
        (lt_add_one (V x₀)))
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hnhds
  have hD : 0 < 2 * (2 * R + 1) := by positivity
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = r / (2 * (2 * R + 1)) := ⟨_, rfl⟩
  have ht : 0 < t := by
    rw [ht_def]
    exact div_pos hr hD
  have h1t : 0 < 1 + t := by linarith
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = 1 / (1 + t) := ⟨_, rfl⟩
  have hs0 : 0 < s := by
    rw [hs_def]
    exact one_div_pos.mpr h1t
  have hs : s * (1 + t) = 1 := by
    rw [hs_def, one_div, inv_mul_cancel₀ h1t.ne']
  refine ⟨V x₀ - 1 / t, fun x hx => ?_⟩
  -- the reflection of `x` through `x₀`, pulled into the ball
  obtain ⟨z, hz_def⟩ : ∃ z : E d, z = x₀ + t • (x₀ - x) := ⟨_, rfl⟩
  have hz : z ∈ Metric.ball x₀ r := by
    have hzx : z - x₀ = t • (x₀ - x) := by
      rw [hz_def, add_sub_cancel_left]
    have hxx : ‖x₀ - x‖ ≤ 2 * R := by
      have := norm_sub_le x₀ x
      linarith [hR x₀ hx₀, hR x hx]
    rw [Metric.mem_ball, dist_eq_norm, hzx, norm_smul, Real.norm_of_nonneg ht.le]
    calc t * ‖x₀ - x‖ ≤ t * (2 * R) := mul_le_mul_of_nonneg_left hxx ht.le
      _ < r := by
        rw [ht_def, div_mul_eq_mul_div, div_lt_iff₀ hD]
        nlinarith [mul_pos hr (show (0 : ℝ) < 2 * R + 2 by linarith)]
  obtain ⟨hzU, hzV⟩ := hball z hz
  -- `x₀` is a convex combination of `z` and `x`
  have hcomb : s • z + (t * s) • x = x₀ := by
    have h1 : s • z + (t * s) • x = (s * (1 + t)) • x₀ := by
      rw [hz_def]
      module
    rw [h1, hs, one_smul]
  have hsum : s + t * s = 1 := by
    rw [← hs]
    ring
  have hconv := hV.2 hzU hx hs0.le (mul_nonneg ht.le hs0.le) hsum
  rw [hcomb] at hconv
  simp only [smul_eq_mul] at hconv
  have h1 : (1 + t) * V x₀ ≤ V z + t * V x := by
    have h := mul_le_mul_of_nonneg_left hconv h1t.le
    have e : (1 + t) * (s * V z + t * s * V x) = (s * (1 + t)) * (V z + t * V x) := by ring
    rw [e, hs, one_mul] at h
    exact h
  have h2 : t * (V x₀ - 1 / t) ≤ t * V x := by
    have e : t * (V x₀ - 1 / t) = t * V x₀ - 1 := by
      rw [mul_sub, mul_one_div_cancel ht.ne']
    rw [e]
    linarith
  exact le_of_mul_le_mul_left h2 ht

/-! ### The estimate -/

/-- The atomic potential estimate for the log-concave source, given a lower bound of `V`. -/
theorem atomicPotentialBound_logConcave_of_le {c₀ : ℝ} (hc₀ : UniformPotentialBound c₀)
    {U : Set (E d)} {V : E d → ℝ} {R m : ℝ} (hU : IsOpen U) (hne : U.Nonempty)
    (hR : ∀ x ∈ U, ‖x‖ ≤ R) (hV : ConvexOn ℝ U V) (hVm : Measurable V)
    (hlow : ∀ x ∈ U, m ≤ V x) :
    AtomicPotentialBound (logConcaveSource U V) (c₀ * Real.sqrt (R ^ 2 + 1)) := by
  obtain ⟨x₀, hx₀⟩ := hne
  have hR0 : 0 ≤ R := (norm_nonneg x₀).trans (hR x₀ hx₀)
  have hUm : MeasurableSet U := hU.measurableSet
  have hvol0 : volume U ≠ 0 := (hU.measure_pos volume ⟨x₀, hx₀⟩).ne'
  have hvol : volume U ≠ ∞ := volume_ne_top_of_norm_le hR
  -- the limit source
  have hexp_meas : Measurable fun x => Real.exp (-V x) := Real.measurable_exp.comp hVm.neg
  have hexp_pos : ∀ x ∈ U, 0 < Real.exp (-V x) := fun x _ => Real.exp_pos _
  have hexp_le : ∀ x ∈ U, Real.exp (-V x) ≤ Real.exp (-m) :=
    fun x hx => Real.exp_le_exp.mpr (neg_le_neg (hlow x hx))
  have hZ0 : expMeasure U V Set.univ ≠ 0 := by
    rw [expMeasure_eq_powerMeasure]
    exact (powerMeasure_univ_pos hUm hexp_meas hvol0 hexp_pos 1).ne'
  have hZtop : expMeasure U V Set.univ ≠ ∞ := by
    rw [expMeasure_eq_powerMeasure]
    exact powerMeasure_univ_ne_top hvol (fun x hx => (hexp_pos x hx).le) hexp_le 1
  have hρprob : IsProbabilityMeasure (logConcaveSource U V) := by
    rw [logConcaveSource_eq_powerSource]
    exact powerSource_isProbabilityMeasure hUm hexp_meas hvol0 hvol hexp_pos hexp_le 1
  have hρac : logConcaveSource U V ≪ volume := by
    rw [logConcaveSource_eq_powerSource]
    exact powerSource_absolutelyContinuous U _ 1
  have hρR : ∀ᵐ x ∂logConcaveSource U V, ‖x‖ ≤ R := by
    rw [logConcaveSource_eq_powerSource]
    filter_upwards [ae_mem_powerSource hUm (fun x => Real.exp (-V x)) 1] with x hx
    exact hR x hx
  -- the approximating sources
  obtain ⟨k₀, hk₀⟩ := exists_nat_gt (max (V x₀) 0)
  have hk₀V : V x₀ < k₀ := (le_max_left _ _).trans_lt hk₀
  have hk₀pos : 0 < k₀ := by
    exact_mod_cast (le_max_right (V x₀) 0).trans_lt hk₀
  have hpos : ∀ N : ℕ, 0 < N + k₀ := fun N => Nat.add_pos_right N hk₀pos
  have hSne : ∀ N : ℕ, (sublevel U V (N + k₀)).Nonempty := by
    intro N
    have hcast : ((k₀ : ℕ) : ℝ) ≤ ((N + k₀ : ℕ) : ℝ) := by
      exact_mod_cast Nat.le_add_left k₀ N
    exact ⟨x₀, And.intro hx₀ (hk₀V.trans_le hcast)⟩
  have hprof : ∀ N : ℕ,
      ConcaveProfile (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (1 + |m|) :=
    fun N => concaveProfile_sublevel hU hV hVm hlow (hpos N) (hSne N)
  have hSR : ∀ N : ℕ, ∀ x ∈ sublevel U V (N + k₀), ‖x‖ ≤ R := fun N x hx => hR x hx.1
  have hSm : ∀ N : ℕ, MeasurableSet (sublevel U V (N + k₀)) :=
    fun N => measurableSet_sublevel hUm hVm (N + k₀)
  have hSvol0 : ∀ N : ℕ, volume (sublevel U V (N + k₀)) ≠ 0 :=
    fun N => ((hprof N).isOpen.measure_pos volume (hSne N)).ne'
  have hSvol : ∀ N : ℕ, volume (sublevel U V (N + k₀)) ≠ ∞ :=
    fun N => volume_ne_top_of_norm_le (hSR N)
  have hM0 : ∀ N : ℕ,
      powerMeasure (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) Set.univ ≠ 0 :=
    fun N => (powerMeasure_univ_pos (hSm N) (hprof N).measurable (hSvol0 N) (hprof N).pos
      (N + k₀)).ne'
  obtain ⟨ρN, hρN⟩ : ∃ ρN : ℕ → Measure (E d), ∀ N,
      ρN N = powerSource (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) :=
    ⟨fun N => powerSource (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀),
      fun _ => rfl⟩
  have hbound : ∀ N, AtomicPotentialBound (ρN N) (c₀ * Real.sqrt (R ^ 2 + 1)) := by
    intro N
    rw [hρN N]
    exact atomicPotentialBound_powerSource_unit hc₀ (hprof N) (hSR N) (hpos N)
  have hρNprob : ∀ N, IsProbabilityMeasure (ρN N) := by
    intro N
    rw [hρN N]
    exact powerSource_isProbabilityMeasure (hSm N) (hprof N).measurable (hSvol0 N) (hSvol N)
      (hprof N).pos (hprof N).le (N + k₀)
  have hρNR : ∀ N, ∀ᵐ x ∂ρN N, ‖x‖ ≤ R := by
    intro N
    rw [hρN N]
    filter_upwards [ae_mem_powerSource (hSm N) (linProfile V (N + k₀)) (N + k₀)] with x hx
    exact hSR N x hx
  -- domination, with constants tending to one
  have hle : ∀ N, ρN N ≤ (expMeasure U V Set.univ /
      powerMeasure (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) Set.univ) •
        logConcaveSource U V := by
    intro N
    rw [hρN N]
    exact powerSource_sublevel_le hUm hVm hZ0 hZtop (N + k₀)
  have hctop : ∀ N, expMeasure U V Set.univ /
      powerMeasure (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) Set.univ ≠ ∞ :=
    fun N => ENNReal.div_ne_top hZtop (hM0 N)
  have hTV := tvBound_of_le_smul (ρN := ρN) (ρ := logConcaveSource U V) hctop hle
  have hε : Tendsto (fun N => (expMeasure U V Set.univ /
      powerMeasure (sublevel U V (N + k₀)) (linProfile V (N + k₀)) (N + k₀) Set.univ).toReal
        - 1) atTop (𝓝 0) := by
    have h1 := ENNReal.Tendsto.const_div (a := expMeasure U V Set.univ)
      (tendsto_powerMeasure_sublevel hUm hVm hZtop k₀) (Or.inl hZtop)
    rw [ENNReal.div_self hZ0 hZtop] at h1
    have h3 := ((ENNReal.tendsto_toReal ENNReal.one_ne_top).comp h1).sub_const 1
    rw [ENNReal.toReal_one, sub_self] at h3
    exact h3
  exact AtomicPotentialBound.of_tendsto hR0 hTV hε hρNR hρR hρac hbound

/-- **Log-concave sources.** If uniform sources satisfy the atomic potential
estimate with constant `c₀ * R`, then the source with density proportional to
`exp (-V)` on a bounded open convex set of radius `R`, with `V` convex,
satisfies it with constant `c₀ * √(R² + 1)`. -/
theorem atomicPotentialBound_logConcave {c₀ : ℝ} (hc₀ : UniformPotentialBound c₀)
    {U : Set (E d)} {V : E d → ℝ} {R : ℝ} (hU : IsOpen U) (hne : U.Nonempty)
    (hR : ∀ x ∈ U, ‖x‖ ≤ R) (hV : ConvexOn ℝ U V) (hVm : Measurable V) :
    AtomicPotentialBound (logConcaveSource U V) (c₀ * Real.sqrt (R ^ 2 + 1)) := by
  obtain ⟨m, hm⟩ := exists_lower_bound_of_convexOn hU hne hR hV
  exact atomicPotentialBound_logConcave_of_le hc₀ hU hne hR hV hVm hm

end

end BrenierMoment
end
-- END SOURCE: BrenierMoment/LogConcave.lean

-- BEGIN SOURCE: BrenierMoment/LineInterpolation.lean
section
/-!
# The interpolation estimate on a line

Let `J ⊆ ℝ` be order-connected with finite length. On the part of `J` whose
two translates by `±h` stay in `J`, a pointwise bound by a squared difference
quotient of `D`, by telescoping differences of two functions with values in
`[-H, H]`, and by an error `γ` is assumed; elsewhere only the bound `4 H²` is
used. The integral over `J` is then bounded by `4/h²` times the integral of
`D²`, by `24 H² h`, and by the integral of `γ`.

The set where a translate leaves `J` has length at most `h` on each side, and
the telescoping sums lose at most `2 H h`. No endpoint of `J` is ever named.
-/

namespace BrenierMoment

open MeasureTheory
open scoped ENNReal

noncomputable section

/-- An order-connected set loses length at most `h` under the shift by `h`. -/
lemma volume_shift_exit_le {A : Set ℝ} (hA : A.OrdConnected) {h : ℝ} (hh : 0 ≤ h) :
    volume {t | t ∈ A ∧ t + h ∉ A} ≤ ENNReal.ofReal h := by
  refine (Real.volume_le_diam _).trans (Metric.ediam_le fun t₁ ht₁ t₂ ht₂ => ?_)
  rw [edist_dist]
  apply ENNReal.ofReal_le_ofReal
  rw [Real.dist_eq, abs_le]
  constructor
  · by_contra hc
    have hlt : t₁ + h < t₂ := by linarith
    exact ht₁.2 (hA.out ht₁.1 ht₂.1 ⟨by linarith, hlt.le⟩)
  · by_contra hc
    have hlt : t₂ + h < t₁ := by linarith
    exact ht₂.2 (hA.out ht₂.1 ht₁.1 ⟨by linarith, hlt.le⟩)

/-- An order-connected set loses length at most `h` under the shift by `-h`. -/
lemma volume_shift_exit_le' {A : Set ℝ} (hA : A.OrdConnected) {h : ℝ} (hh : 0 ≤ h) :
    volume {t | t ∈ A ∧ t - h ∉ A} ≤ ENNReal.ofReal h := by
  refine (Real.volume_le_diam _).trans (Metric.ediam_le fun t₁ ht₁ t₂ ht₂ => ?_)
  rw [edist_dist]
  apply ENNReal.ofReal_le_ofReal
  rw [Real.dist_eq, abs_le]
  constructor
  · by_contra hc
    have hlt : t₁ < t₂ - h := by linarith
    exact ht₂.2 (hA.out ht₁.1 ht₂.1 ⟨hlt.le, by linarith⟩)
  · by_contra hc
    have hlt : t₂ < t₁ - h := by linarith
    exact ht₁.2 (hA.out ht₂.1 ht₁.1 ⟨hlt.le, by linarith⟩)

/-- Integration over a set whose translate stays inside another set. -/
lemma setLIntegral_shift_le {G J : Set ℝ} (hGm : MeasurableSet G) (hJm : MeasurableSet J)
    {h : ℝ} (hGJ : ∀ t ∈ G, t + h ∈ J) (Ψ : ℝ → ℝ≥0∞) :
    (∫⁻ t in G, Ψ (t + h)) ≤ ∫⁻ t in J, Ψ t := by
  have hpt : ∀ t, G.indicator (fun t => Ψ (t + h)) t ≤ J.indicator Ψ (t + h) := by
    intro t
    by_cases ht : t ∈ G
    · rw [Set.indicator_of_mem ht, Set.indicator_of_mem (hGJ t ht)]
    · rw [Set.indicator_of_notMem ht]
      exact zero_le
  calc (∫⁻ t in G, Ψ (t + h)) = ∫⁻ t, G.indicator (fun t => Ψ (t + h)) t :=
        (lintegral_indicator hGm _).symm
    _ ≤ ∫⁻ t, J.indicator Ψ (t + h) := lintegral_mono hpt
    _ = ∫⁻ t, J.indicator Ψ t := lintegral_add_right_eq_self (fun t => J.indicator Ψ t) h
    _ = ∫⁻ t in J, Ψ t := lintegral_indicator hJm Ψ

/-- Telescoping of a bounded function under a shift, over an order-connected set. -/
lemma lintegral_shift_difference_le {G : Set ℝ} (hGm : MeasurableSet G) (hG : G.OrdConnected)
    (hGfin : volume G ≠ ∞) {H h : ℝ} (hH : 0 ≤ H) (hh : 0 ≤ h) {c : ℝ → ℝ}
    (hc : Measurable c) (hcH : ∀ t, |c t| ≤ H) (hmono : ∀ t, c (t - h) ≤ c t) :
    (∫⁻ t in G, ENNReal.ofReal (c t - c (t - h))) ≤ ENNReal.ofReal (2 * H * h) := by
  -- the function shifted into `[0, 2H]`
  obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ≥0∞, F = fun t => ENNReal.ofReal (c t + H) := ⟨_, rfl⟩
  have hFm : Measurable F := by
    rw [hF]
    exact ENNReal.measurable_ofReal.comp (hc.add_const H)
  have hFs : Measurable fun t => F (t - h) := hFm.comp (measurable_id.sub_const h)
  have hFle : ∀ t, F t ≤ ENNReal.ofReal (2 * H) := by
    intro t
    rw [hF]
    exact ENNReal.ofReal_le_ofReal (by linarith [(abs_le.mp (hcH t)).2])
  have hsplit : ∀ t, ENNReal.ofReal (c t - c (t - h)) + F (t - h) = F t := by
    intro t
    rw [hF]
    change ENNReal.ofReal (c t - c (t - h)) + ENNReal.ofReal (c (t - h) + H) =
      ENNReal.ofReal (c t + H)
    rw [← ENNReal.ofReal_add (sub_nonneg.mpr (hmono t))
      (by linarith [(abs_le.mp (hcH (t - h))).1])]
    congr 1
    ring
  have hsum : (∫⁻ t in G, ENNReal.ofReal (c t - c (t - h))) + ∫⁻ t in G, F (t - h) =
      ∫⁻ t in G, F t :=
    (lintegral_add_right (μ := volume.restrict G)
      (fun t => ENNReal.ofReal (c t - c (t - h))) hFs).symm.trans
      (lintegral_congr fun t => hsplit t)
  -- the shifted integral, written over the translated set
  have hB : (∫⁻ t in G, F (t - h)) =
      ∫⁻ t, G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t := by
    calc (∫⁻ t in G, F (t - h)) = ∫⁻ t, G.indicator (fun t => F (t - h)) t :=
          (lintegral_indicator hGm _).symm
      _ = ∫⁻ t, G.indicator (fun t => F (t - h)) (t + h) :=
          (lintegral_add_right_eq_self (fun t => G.indicator (fun t => F (t - h)) t) h).symm
      _ = ∫⁻ t, G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t := by
          apply lintegral_congr
          intro t
          by_cases ht : t + h ∈ G
          · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, one_mul, add_sub_cancel_right]
          · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht, zero_mul]
  -- the two integrals differ by the part of `G` that the shift moves out
  obtain ⟨X, hX⟩ : ∃ X : Set ℝ, X = {t | t ∈ G ∧ t + h ∉ G} := ⟨_, rfl⟩
  have hXm : MeasurableSet X := by
    rw [hX]
    exact hGm.inter ((measurable_id.add_const h) hGm.compl)
  have hXvol : volume X ≤ ENNReal.ofReal h := by
    rw [hX]
    exact volume_shift_exit_le hG hh
  have hpt : ∀ t, G.indicator F t ≤ G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t +
      X.indicator (fun _ => ENNReal.ofReal (2 * H)) t := by
    intro t
    by_cases ht : t ∈ G
    · by_cases hth : t + h ∈ G
      · rw [Set.indicator_of_mem ht, Set.indicator_of_mem hth, one_mul]
        exact le_self_add
      · have htX : t ∈ X := by
          rw [hX]
          exact ⟨ht, hth⟩
        rw [Set.indicator_of_mem ht, Set.indicator_of_notMem hth, zero_mul, zero_add,
          Set.indicator_of_mem htX]
        exact hFle t
    · rw [Set.indicator_of_notMem ht]
      exact zero_le
  have hm1 : Measurable fun t => G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t :=
    ((measurable_const.indicator hGm).comp (measurable_id.add_const h)).mul hFm
  have hA : (∫⁻ t in G, F t) ≤ (∫⁻ t in G, F (t - h)) + ENNReal.ofReal (2 * H * h) := by
    calc (∫⁻ t in G, F t) = ∫⁻ t, G.indicator F t := (lintegral_indicator hGm F).symm
      _ ≤ ∫⁻ t, (G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t +
            X.indicator (fun _ => ENNReal.ofReal (2 * H)) t) := lintegral_mono hpt
      _ = (∫⁻ t, G.indicator (fun _ => (1 : ℝ≥0∞)) (t + h) * F t) +
            ∫⁻ t, X.indicator (fun _ => ENNReal.ofReal (2 * H)) t := lintegral_add_left hm1 _
      _ = (∫⁻ t in G, F (t - h)) + ENNReal.ofReal (2 * H) * volume X := by
          rw [← hB, lintegral_indicator_const hXm]
      _ ≤ (∫⁻ t in G, F (t - h)) + ENNReal.ofReal (2 * H) * ENNReal.ofReal h := by gcongr
      _ = (∫⁻ t in G, F (t - h)) + ENNReal.ofReal (2 * H * h) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
  have hBfin : (∫⁻ t in G, F (t - h)) ≠ ∞ := by
    refine ne_top_of_le_ne_top ?_ (setLIntegral_mono' hGm fun t _ => hFle (t - h))
    rw [setLIntegral_const]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hGfin
  have hfinal : (∫⁻ t in G, ENNReal.ofReal (c t - c (t - h))) + ∫⁻ t in G, F (t - h) ≤
      ENNReal.ofReal (2 * H * h) + ∫⁻ t in G, F (t - h) := by
    rw [hsum, add_comm (ENNReal.ofReal (2 * H * h))]
    exact hA
  exact ENNReal.le_of_add_le_add_right hBfin hfinal

/-- **Interpolation on a line.** -/
theorem line_interpolation {J : Set ℝ} (hJm : MeasurableSet J) (hJ : J.OrdConnected)
    (hJfin : volume J ≠ ∞) {H h : ℝ} (hH : 0 ≤ H) (hh : 0 < h)
    {φ γ : ℝ → ℝ≥0∞} (hγ : Measurable γ)
    {D cu cv : ℝ → ℝ} (hD : Measurable D) (hcu : Measurable cu) (hcv : Measurable cv)
    (hcuH : ∀ t, |cu t| ≤ H) (hcvH : ∀ t, |cv t| ≤ H)
    (hcu_mono : ∀ t, cu (t - h) ≤ cu t) (hcv_mono : ∀ t, cv (t - h) ≤ cv t)
    (ha : ∀ t ∈ J, φ t ≤ ENNReal.ofReal (4 * H ^ 2))
    (hb : ∀ t, t ∈ J → t + h ∈ J → t - h ∈ J →
      φ t ≤ ENNReal.ofReal (((D (t + h) - D t) / h) ^ 2) +
        ENNReal.ofReal (4 * H) * (ENNReal.ofReal (cu t - cu (t - h)) +
          ENNReal.ofReal (cv t - cv (t - h))) + γ t) :
    (∫⁻ t in J, φ t) ≤
      ENNReal.ofReal (4 / h ^ 2) * (∫⁻ t in J, ENNReal.ofReal (D t ^ 2)) +
        ENNReal.ofReal (24 * H ^ 2 * h) + ∫⁻ t in J, γ t := by
  -- the part of `J` whose two translates stay in `J`
  obtain ⟨G, hG⟩ : ∃ G : Set ℝ, G = {t | t ∈ J ∧ t + h ∈ J ∧ t - h ∈ J} := ⟨_, rfl⟩
  have hGm : MeasurableSet G := by
    rw [hG]
    exact hJm.inter (((measurable_id.add_const h) hJm).inter ((measurable_id.sub_const h) hJm))
  have hGJ : G ⊆ J := by
    rw [hG]
    exact fun t ht => ht.1
  have hGord : G.OrdConnected := by
    rw [hG]
    refine ⟨fun x hx y hy z hz => ⟨hJ.out hx.1 hy.1 hz, ?_, ?_⟩⟩
    · exact hJ.out hx.2.1 hy.2.1 ⟨by linarith [hz.1], by linarith [hz.2]⟩
    · exact hJ.out hx.2.2 hy.2.2 ⟨by linarith [hz.1], by linarith [hz.2]⟩
  have hGfin : volume G ≠ ∞ := ne_top_of_le_ne_top hJfin (measure_mono hGJ)
  -- the rest of `J` has length at most `2h`
  have hbad : volume (J \ G) ≤ ENNReal.ofReal (2 * h) := by
    have hsub : J \ G ⊆ {t | t ∈ J ∧ t + h ∉ J} ∪ {t | t ∈ J ∧ t - h ∉ J} := by
      intro t ht
      rw [hG] at ht
      by_cases h1 : t + h ∈ J
      · exact Or.inr ⟨ht.1, fun h2 => ht.2 ⟨ht.1, h1, h2⟩⟩
      · exact Or.inl ⟨ht.1, h1⟩
    calc volume (J \ G)
        ≤ volume ({t | t ∈ J ∧ t + h ∉ J} ∪ {t | t ∈ J ∧ t - h ∉ J}) := measure_mono hsub
      _ ≤ volume {t | t ∈ J ∧ t + h ∉ J} + volume {t | t ∈ J ∧ t - h ∉ J} :=
          measure_union_le _ _
      _ ≤ ENNReal.ofReal h + ENNReal.ofReal h :=
          add_le_add (volume_shift_exit_le hJ hh.le) (volume_shift_exit_le' hJ hh.le)
      _ = ENNReal.ofReal (2 * h) := by
          rw [← ENNReal.ofReal_add hh.le hh.le]
          congr 1
          ring
  -- the three terms of the pointwise bound
  obtain ⟨E1, hE1⟩ : ∃ E1 : ℝ → ℝ≥0∞,
      E1 = fun t => ENNReal.ofReal (((D (t + h) - D t) / h) ^ 2) := ⟨_, rfl⟩
  obtain ⟨E2, hE2⟩ : ∃ E2 : ℝ → ℝ≥0∞, E2 = fun t => ENNReal.ofReal (4 * H) *
      (ENNReal.ofReal (cu t - cu (t - h)) + ENNReal.ofReal (cv t - cv (t - h))) := ⟨_, rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ → ℝ≥0∞, Ψ = fun t => ENNReal.ofReal (D t ^ 2) := ⟨_, rfl⟩
  have hΨm : Measurable Ψ := by
    rw [hΨ]
    exact ENNReal.measurable_ofReal.comp (hD.pow_const 2)
  have hmu : Measurable fun t => ENNReal.ofReal (cu t - cu (t - h)) :=
    ENNReal.measurable_ofReal.comp (hcu.sub (hcu.comp (measurable_id.sub_const h)))
  have hmv : Measurable fun t => ENNReal.ofReal (cv t - cv (t - h)) :=
    ENNReal.measurable_ofReal.comp (hcv.sub (hcv.comp (measurable_id.sub_const h)))
  have hmuv : Measurable fun t =>
      ENNReal.ofReal (cu t - cu (t - h)) + ENNReal.ofReal (cv t - cv (t - h)) := hmu.add hmv
  have hE2m : Measurable E2 := by
    rw [hE2]
    exact hmuv.const_mul _
  have hpt : ∀ t, J.indicator φ t ≤ G.indicator (fun t => E1 t + E2 t + γ t) t +
      (J \ G).indicator (fun _ => ENNReal.ofReal (4 * H ^ 2)) t := by
    intro t
    by_cases htJ : t ∈ J
    · by_cases htG : t ∈ G
      · have hnot : t ∉ J \ G := fun hc => hc.2 htG
        have htG' := htG
        rw [hG] at htG'
        rw [Set.indicator_of_mem htJ, Set.indicator_of_mem htG, Set.indicator_of_notMem hnot,
          add_zero, hE1, hE2]
        exact hb t htG'.1 htG'.2.1 htG'.2.2
      · have hmem : t ∈ J \ G := ⟨htJ, htG⟩
        rw [Set.indicator_of_mem htJ, Set.indicator_of_notMem htG, Set.indicator_of_mem hmem,
          zero_add]
        exact ha t htJ
    · rw [Set.indicator_of_notMem htJ]
      exact zero_le
  have hint : (∫⁻ t in J, φ t) ≤ (∫⁻ t in G, (E1 t + E2 t + γ t)) +
      ENNReal.ofReal (4 * H ^ 2) * volume (J \ G) := by
    calc (∫⁻ t in J, φ t) = ∫⁻ t, J.indicator φ t := (lintegral_indicator hJm φ).symm
      _ ≤ ∫⁻ t, (G.indicator (fun t => E1 t + E2 t + γ t) t +
            (J \ G).indicator (fun _ => ENNReal.ofReal (4 * H ^ 2)) t) := lintegral_mono hpt
      _ = (∫⁻ t, G.indicator (fun t => E1 t + E2 t + γ t) t) +
            ∫⁻ t, (J \ G).indicator (fun _ => ENNReal.ofReal (4 * H ^ 2)) t :=
          lintegral_add_right _ (measurable_const.indicator (hJm.diff hGm))
      _ = (∫⁻ t in G, (E1 t + E2 t + γ t)) + ENNReal.ofReal (4 * H ^ 2) * volume (J \ G) := by
          rw [lintegral_indicator hGm, lintegral_indicator_const (hJm.diff hGm)]
  have hsplit : (∫⁻ t in G, (E1 t + E2 t + γ t)) =
      (∫⁻ t in G, E1 t) + (∫⁻ t in G, E2 t) + ∫⁻ t in G, γ t := by
    rw [lintegral_add_right _ hγ, lintegral_add_right _ hE2m]
  -- the difference quotient
  have hE1le : ∀ t, E1 t ≤ ENNReal.ofReal (2 / h ^ 2) * (Ψ (t + h) + Ψ t) := by
    intro t
    have hreal : ((D (t + h) - D t) / h) ^ 2 ≤ 2 / h ^ 2 * (D (t + h) ^ 2 + D t ^ 2) := by
      have h1 : ((D (t + h) - D t) / h) ^ 2 = (D (t + h) - D t) ^ 2 / h ^ 2 := div_pow _ _ _
      have h2 : 2 / h ^ 2 * (D (t + h) ^ 2 + D t ^ 2) =
          (2 * (D (t + h) ^ 2 + D t ^ 2)) / h ^ 2 := by ring
      rw [h1, h2]
      exact div_le_div_of_nonneg_right (by nlinarith [sq_nonneg (D (t + h) + D t)])
        (by positivity)
    rw [hE1, hΨ]
    change ENNReal.ofReal (((D (t + h) - D t) / h) ^ 2) ≤
      ENNReal.ofReal (2 / h ^ 2) * (ENNReal.ofReal (D (t + h) ^ 2) + ENNReal.ofReal (D t ^ 2))
    rw [← ENNReal.ofReal_add (sq_nonneg _) (sq_nonneg _), ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have hΨs : Measurable fun t => Ψ (t + h) + Ψ t :=
    (hΨm.comp (measurable_id.add_const h)).add hΨm
  have hshift : (∫⁻ t in G, Ψ (t + h)) ≤ ∫⁻ t in J, Ψ t :=
    setLIntegral_shift_le hGm hJm
      (fun t ht => by
        rw [hG] at ht
        exact ht.2.1) Ψ
  have hstay : (∫⁻ t in G, Ψ t) ≤ ∫⁻ t in J, Ψ t := lintegral_mono_set hGJ
  have hfour : ENNReal.ofReal (4 / h ^ 2) = ENNReal.ofReal (2 / h ^ 2) * 2 := by
    rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    ring
  have hI1 : (∫⁻ t in G, E1 t) ≤ ENNReal.ofReal (4 / h ^ 2) * ∫⁻ t in J, Ψ t := by
    calc (∫⁻ t in G, E1 t)
        ≤ ∫⁻ t in G, ENNReal.ofReal (2 / h ^ 2) * (Ψ (t + h) + Ψ t) :=
          lintegral_mono fun t => hE1le t
      _ = ENNReal.ofReal (2 / h ^ 2) * ((∫⁻ t in G, Ψ (t + h)) + ∫⁻ t in G, Ψ t) := by
          rw [lintegral_const_mul _ hΨs, lintegral_add_right _ hΨm]
      _ ≤ ENNReal.ofReal (2 / h ^ 2) * ((∫⁻ t in J, Ψ t) + ∫⁻ t in J, Ψ t) := by gcongr
      _ = ENNReal.ofReal (4 / h ^ 2) * ∫⁻ t in J, Ψ t := by
          rw [hfour, mul_assoc, two_mul]
  -- the telescoping terms
  have hE2eq : (∫⁻ t in G, E2 t) = ∫⁻ t in G, ENNReal.ofReal (4 * H) *
      (ENNReal.ofReal (cu t - cu (t - h)) + ENNReal.ofReal (cv t - cv (t - h))) := by
    rw [hE2]
  have hu := lintegral_shift_difference_le hGm hGord hGfin hH hh.le hcu hcuH hcu_mono
  have hv := lintegral_shift_difference_le hGm hGord hGfin hH hh.le hcv hcvH hcv_mono
  have hI2 : (∫⁻ t in G, E2 t) ≤ ENNReal.ofReal (16 * H ^ 2 * h) := by
    calc (∫⁻ t in G, E2 t)
        = ENNReal.ofReal (4 * H) * ((∫⁻ t in G, ENNReal.ofReal (cu t - cu (t - h))) +
            ∫⁻ t in G, ENNReal.ofReal (cv t - cv (t - h))) := by
          rw [hE2eq, lintegral_const_mul _ hmuv, lintegral_add_right _ hmv]
      _ ≤ ENNReal.ofReal (4 * H) *
            (ENNReal.ofReal (2 * H * h) + ENNReal.ofReal (2 * H * h)) := by gcongr
      _ = ENNReal.ofReal (16 * H ^ 2 * h) := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
  have hI3 : (∫⁻ t in G, γ t) ≤ ∫⁻ t in J, γ t := lintegral_mono_set hGJ
  have e1 : ENNReal.ofReal (4 * H ^ 2) * ENNReal.ofReal (2 * h) =
      ENNReal.ofReal (8 * H ^ 2 * h) := by
    rw [← ENNReal.ofReal_mul (by positivity)]
    congr 1
    ring
  have e2 : ENNReal.ofReal (16 * H ^ 2 * h) + ENNReal.ofReal (8 * H ^ 2 * h) =
      ENNReal.ofReal (24 * H ^ 2 * h) := by
    rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 1
    ring
  have hfinal : (∫⁻ t in J, φ t) ≤ ENNReal.ofReal (4 / h ^ 2) * (∫⁻ t in J, Ψ t) +
      ENNReal.ofReal (24 * H ^ 2 * h) + ∫⁻ t in J, γ t := by
    calc (∫⁻ t in J, φ t)
        ≤ (∫⁻ t in G, (E1 t + E2 t + γ t)) +
            ENNReal.ofReal (4 * H ^ 2) * volume (J \ G) := hint
      _ = (∫⁻ t in G, E1 t) + (∫⁻ t in G, E2 t) + (∫⁻ t in G, γ t) +
            ENNReal.ofReal (4 * H ^ 2) * volume (J \ G) := by rw [hsplit]
      _ ≤ ENNReal.ofReal (4 / h ^ 2) * (∫⁻ t in J, Ψ t) + ENNReal.ofReal (16 * H ^ 2 * h) +
            (∫⁻ t in J, γ t) + ENNReal.ofReal (4 * H ^ 2) * ENNReal.ofReal (2 * h) := by
          gcongr
      _ = ENNReal.ofReal (4 / h ^ 2) * (∫⁻ t in J, Ψ t) + ENNReal.ofReal (24 * H ^ 2 * h) +
            ∫⁻ t in J, γ t := by
          rw [e1, ← e2]
          ring
  rw [hΨ] at hfinal
  exact hfinal

end

end BrenierMoment
end
