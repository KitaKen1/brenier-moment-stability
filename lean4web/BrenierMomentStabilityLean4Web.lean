    {m : ι → ℝ} {n : κ → ℝ} {y : ι → E d} {z : κ → E d}
    (hm : ∀ i, 0 ≤ m i) (hn : ∀ j, 0 ≤ n j) (hm1 : ∑ i, m i = 1)
