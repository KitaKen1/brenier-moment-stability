    ∑ u, rectangleSwap w ε i k j l u v = ∑ u, w u v := by
  simp [rectangleSwap, Finset.sum_add_distrib, ← Finset.sum_mul,
    ← Finset.mul_sum, Finset.sum_sub_distrib]

