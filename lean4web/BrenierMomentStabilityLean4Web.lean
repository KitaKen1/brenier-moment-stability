  intro u
  apply tendsto_remainder_trace J (hFp u) hp.1 hw
  · intro k hk
    exact ((hFp u).inner (ha k hk)).add (hb k hk)
  · intro k hk heq
    apply hp.2 k (hJ k hk).1 (hJ k hk).2
