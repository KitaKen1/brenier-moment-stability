    ∀ᵐ x ∂target a R 0, x 1 = 0 := by
  unfold target
  rw [ae_finsetSum_measure_iff]
  intro i hi
  apply Measure.ae_smul_measure
  have hx : atoms R 0 i 1 = 0 := by fin_cases i <;> simp [atoms]
  simpa using hx

