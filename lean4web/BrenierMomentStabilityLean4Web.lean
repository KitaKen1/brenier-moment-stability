/-- The real one-third power is a nonnegative cube root. -/
lemma one_third_rpow_cube {w : ℝ} (hw : 0 ≤ w) :
    (Real.rpow w (1 / 3 : ℝ)) ^ 3 = w := by
  calc
    (Real.rpow w (1 / 3 : ℝ)) ^ 3 =
