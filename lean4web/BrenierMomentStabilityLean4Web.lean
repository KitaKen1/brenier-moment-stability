  · by_contra h
    have hempty : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp h
    simp [hempty] at hsum
  · intro x hx
    exact hF.mem_toFinset.mp (Finset.mem_filter.mp hx).1
  · intro x hx
    exact pos_iff_ne_zero.mpr (Finset.mem_filter.mp hx).2

