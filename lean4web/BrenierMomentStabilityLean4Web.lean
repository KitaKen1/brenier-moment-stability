/-- Open-interior coordinate samplers suffice for the exact original body laws. -/
theorem exists_midpoint_coupling_of_interior_coordinate_samplers
    {Ω : Type*} [MeasurableSpace Ω] {ρ : Measure Ω} [IsProbabilityMeasure ρ]
