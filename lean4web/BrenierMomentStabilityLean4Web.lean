theorem exists_joint_measurable_affine_argmax_with_masses
    {P ι : Type*} [MeasurableSpace P] [MeasurableSpace ι]
    [Fintype ι] [Nonempty ι] {d : ℕ} (K : Set (E d))
    (y : P → ι → E d) (c m : P → ι → ℝ)
