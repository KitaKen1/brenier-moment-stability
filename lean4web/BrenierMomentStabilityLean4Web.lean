    (diagonalProduct_densityRatio_eq_initial r E v N hEzero hEstep hvpos hvterminal)
  · intro n hn s hs t ht
    exact hderivq n hn _ (sample_mem_domains_of_le q D N hDzero hDstep n hn.le s hs) t ht
  · intro n hn s hs t ht
