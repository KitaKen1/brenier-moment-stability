    [AddCommMonoid A] [Module ℝ A]
    {U K : Set (A × ℝ)} (hU : IsOpen U) (hc : Convex ℝ U)
    (hK : IsCompact K) (hUK : U ⊆ K) {a : A} (ha : a ∈ Prod.fst '' U) :
