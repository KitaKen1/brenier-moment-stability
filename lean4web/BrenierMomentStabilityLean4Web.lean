  have h : Measurable (fun x => ∑ i, {x | k x = i}.indicator (g i) x) := by
    exact Finset.measurable_sum _ (fun i _ => (hg i).indicator (hk i))
  convert h using 1
  funext x
  simp [Set.indicator_apply]

