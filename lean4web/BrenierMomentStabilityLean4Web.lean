    {K : Set (E d)} (hK : MeasurableSet K)
    (y : ι → E d) (c : ι → ℝ) (i : ι) (hinj : Function.Injective y)
    {f : E d → V} (hf : Integrable f (uniformMeasure K)) :
    ContinuousAt (fun p : (ι → E d) × (ι → ℝ) =>
