    (hK : IsCompact K) {h : n ≤ d} {a : Coordinates n}
    (ha : a ∈ prefixDomain K h) :
    0 < (volume (prefixSection K h a)).toReal :=
  ENNReal.toReal_pos (prefixSection_volume_pos ha).ne'
    (isCompact_prefixSection hK h a).measure_ne_top

