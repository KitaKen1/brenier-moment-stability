theorem exists_measurable_limit_with_property
    {α β : Type*} [MeasurableSpace α] [MetricSpace β]
    [MeasurableSpace β] [BorelSpace β] [Nonempty β]
    {ρ : Measure α} {f : ℕ → α → β} {P : α → β → Prop}
