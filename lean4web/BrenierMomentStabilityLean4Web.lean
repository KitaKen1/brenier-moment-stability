      (fun x => 2 * (|r| + ‖v‖ * ‖base x‖) / ⟪n, u⟫_ℝ) := by fun_prop
  obtain ⟨B, _, hdom, hbound⟩ :=
    MovingCellTrace.exists_compact_projection_domination
      (μ := μ) J hK hP (fun p : X × ℝ => base p.1 + p.2 • u)
