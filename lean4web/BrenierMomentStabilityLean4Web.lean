  filter_upwards [hT n] with x hx
  obtain ⟨i, hi, _⟩ := hx
  rw [hi, Metric.mem_closedBall, dist_zero_right]
  exact (norm_le_pi_norm (y n) i).trans ((hR _ ⟨n, rfl⟩).trans (le_max_left _ _))

