    apply le_sInf
    intro r hr
    by_cases hrTop : r = ∞
    · simp only [hrTop, le_top]
    have hdiv : D / L ≤ Real.sqrt r.toReal :=
      (div_le_iff₀ hLpos).mpr (by simpa only [mul_comm] using hbound r hr hrTop)
    apply ENNReal.ofReal_le_of_le_toReal
