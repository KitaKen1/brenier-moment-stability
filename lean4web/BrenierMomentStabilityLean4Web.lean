    congrArg (fun p : ProbabilityMeasure (E d) => (p : Measure (E d))) hπ.1
  have hsnd : Measure.map Prod.snd (π : Measure (E d × E d)) = ν :=
    congrArg (fun p : ProbabilityMeasure (E d) => (p : Measure (E d))) hπ.2
