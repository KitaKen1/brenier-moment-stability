      (∑ i, m i * c i) = 0 ∧
      ∀ a : ι → ℝ, (∑ i, m i * a i) = 0 →
        (∫ x, potential y c x ∂uniformMeasure K) ≤ ∫ x, potential y a x ∂uniformMeasure K := by
    intro y
