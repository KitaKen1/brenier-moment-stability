    (hedge : (strictTieGraph K (fun k => TripleCell.score (y k) (c k))).Adj i j)
    (base : E d)
    (hbase : TripleCell.score (y i) (c i) base = TripleCell.score (y j) (c j) base)
    (μ : Measure ((ℝ ∙ (y i - y j))ᗮ))
    [IsOpenPosMeasure μ] [IsFiniteMeasureOnCompacts μ] :
