theorem IsCoupling.atomic_cost_ne_top {d : ℕ} {ι κ : Type*} [Fintype ι] [Fintype κ]
    {w : ι → ℝ≥0∞} {v : κ → ℝ≥0∞} {y : ι → E d} {z : κ → E d}
