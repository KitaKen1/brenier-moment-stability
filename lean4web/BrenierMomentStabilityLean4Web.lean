      {x | x ∈ K ∧ x + h • v ∉ K} := by
    ext x
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, ← heqshift x,
      Set.mem_image, e.injective.eq_iff, exists_eq_right]
  have hm : MeasurableSet {p : X × ℝ | p ∈ e '' K ∧ (p.1, p.2 + h) ∉ e '' K} :=
    himage.measurableSet.inter
