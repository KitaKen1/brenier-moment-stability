  intro a
  constructor
  change ((ν (K a))⁻¹ • ν.restrict (K a)) univ = 1
  simp only [Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ,
    univ_inter, smul_eq_mul]
  exact ENNReal.inv_mul_cancel (hzero a) (htop a)

