    μ = Measure.dirac y := by
  have hae : ∀ᵐ x ∂μ, x = y := by
    exact ae_iff.mpr hμ
  calc
    μ = Measure.map id μ := Measure.map_id.symm
    _ = Measure.map (fun _ => y) μ := Measure.map_congr hae
    _ = Measure.dirac y := by simp [Measure.map_const]

