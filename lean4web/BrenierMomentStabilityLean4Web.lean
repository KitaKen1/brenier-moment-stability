/-- Zero-mass sites can be discarded from any finite support without changing the measure. -/
theorem exists_positive_atomic_support {d : ℕ} {μ : Measure (E d)}
    [IsProbabilityMeasure μ] {F : Set (E d)} (hF : F.Finite)
    (hμ : IsSupported μ F) :
