  have hs : 0 < Real.sqrt a := Real.sqrt_pos.mpr ha
  have h1 : scaleOf a δ * a / 4 = δ / Real.sqrt a := by
    unfold scaleOf
    calc 4 * δ / (a * Real.sqrt a) * a / 4
